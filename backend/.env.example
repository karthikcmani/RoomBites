# RoomBites Server Environment Variables
PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
JWT_SECRET=super_secret_roombites_jwt_development_key_minimum_32_chars_long
ADMIN_SECRET_KEY=roombites_admin_master_setup_key_2026

# Database configuration
# To use SQLite file locally (default):
DB_TYPE=sqlite
DB_PATH=./roombites.db

# To use PostgreSQL / Supabase:
# DB_TYPE=postgres
# DATABASE_URL=postgresql://postgres:password@localhost:5432/roombites

# Initial Admin Settings
ADMIN_EMAIL=admin@rit.ac.in
ADMIN_NAME=Mess Operator Admin
ADMIN_ROOM=Admin Room 101
ADMIN_PHONE=+919876543210
