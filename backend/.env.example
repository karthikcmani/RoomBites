# RoomBites Server Environment Variables
PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Cryptographic Session Secrets (Minimum 32 characters in production)
JWT_SECRET=super_secret_roombites_jwt_development_key_minimum_32_chars_long
OTP_SECRET=super_secret_roombites_otp_pepper_development_key_minimum_32_chars_long
ADMIN_SECRET_KEY=roombites_admin_master_setup_key_2026

# Transactional Email Provider Configuration (SMTP)
# Real SMTP credentials required for production OTP delivery
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=auth@rit.ac.in
SMTP_PASS=your_email_provider_app_password
SMTP_FROM="RoomBites RIT" <noreply@rit.ac.in>

# Database configuration
# To use SQLite file locally (default):
DB_TYPE=sqlite
DB_PATH=./roombites.db

# To use PostgreSQL / Supabase in production:
# DB_TYPE=postgres
# DATABASE_URL=postgresql://postgres:password@localhost:5432/roombites

# Initial Admin Identity (Pre-seeded seller admin)
ADMIN_EMAIL=admin@rit.ac.in
ADMIN_NAME=Mess Operator Admin
ADMIN_ROOM=Admin Room 101
ADMIN_PHONE=+919876543210
